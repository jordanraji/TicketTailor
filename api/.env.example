# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tickettailor
DATABASE_REPLICA_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tickettailor

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=super-secret-dev-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS config for SQS/SNS
AWS_REGION=ap-southeast-2
AWS_SNS_TOPIC_ARN=

# Email (ADR-0012). Provider is "resend" in prod, "smtp" for local/CI via Mailpit.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@tickettailor.local
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# Web push (ADR-0011). Server-side VAPID keypair; placeholder for local dev.
VAPID_PUBLIC_KEY=MOCK_VAPID_PUBLIC_KEY_PLACEHOLDER

# CORS. Comma-separated list of allowed SPA origins. Defaults to the local
# frontend dev server; set to the deployed frontend origin in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
