    "WorkerLambdaVersionhM1zinyq9oL1E60AxGKfAG9ezVg1y500ArZQxMdWKo": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
